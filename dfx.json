{
  "canisters": {
    "constitution": {
      "type": "motoko",
      "main": "canisters/constitution/main.mo"
    },
    "square_escrow": {
      "type": "motoko",
      "main": "canisters/square_escrow/main.mo"
    },
    "square_core": {
      "type": "motoko",
      "main": "canisters/square_core/main.mo"
    },
    "frontend_assets": {
      "type": "assets",
      "source": [
        "canisters/frontend_assets/assets"
      ]
    },
    "test_ledger": {
      "type": "motoko",
      "main": "canisters/test_ledger/main.mo"
    }
  },
  "defaults": {
    "build": {
      "packtool": "mops sources"
    }
  },
  "networks": {
    "local": {
      "bind": "127.0.0.1:4943",
      "type": "ephemeral"
    }
  },
  "output_env_file": ".env",
  "version": 1
}
